<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Process_TO_BE" targetNamespace="https://portfolio.example/ecommerce-conversion" exporter="ChatGPT" exporterVersion="1.0">
  <bpmn:process id="Process_TO_BE" name="TO-BE propuesto - GA4 checkout" isExecutable="false">
    <bpmn:startEvent id="to_start" name="Producto visualizado">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="to_product" name="Mostrar ficha, precio y envío estimado">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="to_cartgw" name="¿Añadir al carrito?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="to_cart" name="Confirmar carrito y total">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="to_check" name="Checkout con pasos visibles">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="to_shipping" name="Validar datos de envío en línea">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="to_validgw" name="¿Datos válidos?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="to_payment" name="Mostrar total y opciones de pago">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="to_paygw" name="¿Pago confirmado?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="to_confirm" name="Mostrar confirmación + medir evento">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="to_end" name="Compra completada">
      <bpmn:incoming>Flow_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="to_exit" name="Sale sin añadir">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="to_fix" name="Mostrar errores y permitir corrección">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="to_retry" name="Explicar rechazo y habilitar reintento">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="to_start" targetRef="to_product" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="to_product" targetRef="to_cartgw" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="to_cartgw" targetRef="to_cart" name="Sí" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="to_cartgw" targetRef="to_exit" name="No" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="to_cart" targetRef="to_check" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="to_check" targetRef="to_shipping" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="to_shipping" targetRef="to_validgw" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="to_validgw" targetRef="to_payment" name="Sí" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="to_validgw" targetRef="to_fix" name="No" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="to_fix" targetRef="to_shipping" name="Corregir" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="to_payment" targetRef="to_paygw" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="to_paygw" targetRef="to_confirm" name="Sí" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="to_paygw" targetRef="to_retry" name="No" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="to_retry" targetRef="to_payment" name="Reintentar" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="to_confirm" targetRef="to_end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Process_TO_BE">
    <bpmndi:BPMNPlane id="Plane_Process_TO_BE" bpmnElement="Process_TO_BE">
      <bpmndi:BPMNShape id="Shape_to_start" bpmnElement="to_start">
        <dc:Bounds x="80" y="180" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_to_product" bpmnElement="to_product">
        <dc:Bounds x="160" y="160" width="145" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_to_cartgw" bpmnElement="to_cartgw">
        <dc:Bounds x="360" y="175" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_to_cart" bpmnElement="to_cart">
        <dc:Bounds x="480" y="160" width="145" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_to_check" bpmnElement="to_check">
        <dc:Bounds x="680" y="160" width="145" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_to_shipping" bpmnElement="to_shipping">
        <dc:Bounds x="880" y="160" width="145" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_to_validgw" bpmnElement="to_validgw">
        <dc:Bounds x="1080" y="175" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_to_payment" bpmnElement="to_payment">
        <dc:Bounds x="1200" y="160" width="145" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_to_paygw" bpmnElement="to_paygw">
        <dc:Bounds x="1400" y="175" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_to_confirm" bpmnElement="to_confirm">
        <dc:Bounds x="1520" y="160" width="145" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_to_end" bpmnElement="to_end">
        <dc:Bounds x="1720" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_to_exit" bpmnElement="to_exit">
        <dc:Bounds x="420" y="380" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_to_fix" bpmnElement="to_fix">
        <dc:Bounds x="900" y="350" width="145" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_to_retry" bpmnElement="to_retry">
        <dc:Bounds x="1330" y="350" width="145" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_1" bpmnElement="Flow_1">
        <di:waypoint x="116" y="198.0" />
        <di:waypoint x="138.0" y="198.0" />
        <di:waypoint x="138.0" y="200.0" />
        <di:waypoint x="160" y="200.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_2" bpmnElement="Flow_2">
        <di:waypoint x="305" y="200.0" />
        <di:waypoint x="360" y="200.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_3" bpmnElement="Flow_3">
        <di:waypoint x="410" y="200.0" />
        <di:waypoint x="480" y="200.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_4" bpmnElement="Flow_4">
        <di:waypoint x="410" y="200.0" />
        <di:waypoint x="415.0" y="200.0" />
        <di:waypoint x="415.0" y="398.0" />
        <di:waypoint x="420" y="398.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_5" bpmnElement="Flow_5">
        <di:waypoint x="625" y="200.0" />
        <di:waypoint x="680" y="200.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_6" bpmnElement="Flow_6">
        <di:waypoint x="825" y="200.0" />
        <di:waypoint x="880" y="200.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_7" bpmnElement="Flow_7">
        <di:waypoint x="1025" y="200.0" />
        <di:waypoint x="1080" y="200.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_8" bpmnElement="Flow_8">
        <di:waypoint x="1130" y="200.0" />
        <di:waypoint x="1200" y="200.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_9" bpmnElement="Flow_9">
        <di:waypoint x="1130" y="200.0" />
        <di:waypoint x="1155" y="200.0" />
        <di:waypoint x="1155" y="390.0" />
        <di:waypoint x="900" y="390.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_10" bpmnElement="Flow_10">
        <di:waypoint x="1045" y="390.0" />
        <di:waypoint x="1070" y="390.0" />
        <di:waypoint x="1070" y="200.0" />
        <di:waypoint x="880" y="200.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_11" bpmnElement="Flow_11">
        <di:waypoint x="1345" y="200.0" />
        <di:waypoint x="1400" y="200.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_12" bpmnElement="Flow_12">
        <di:waypoint x="1450" y="200.0" />
        <di:waypoint x="1520" y="200.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_13" bpmnElement="Flow_13">
        <di:waypoint x="1450" y="200.0" />
        <di:waypoint x="1475" y="200.0" />
        <di:waypoint x="1475" y="390.0" />
        <di:waypoint x="1330" y="390.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_14" bpmnElement="Flow_14">
        <di:waypoint x="1475" y="390.0" />
        <di:waypoint x="1500" y="390.0" />
        <di:waypoint x="1500" y="200.0" />
        <di:waypoint x="1200" y="200.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_15" bpmnElement="Flow_15">
        <di:waypoint x="1665" y="200.0" />
        <di:waypoint x="1720" y="200.0" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>